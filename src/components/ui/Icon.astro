---
interface Props {
  name: string;
  class?: string;
  label?: string;
}

const icons = import.meta.glob<string>('../../assets/svg/*.svg', { query: '?raw', import: 'default', eager: true });
const { name, class: className, label } = Astro.props;
const raw = icons[`../../assets/svg/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" no existe en src/assets/svg`);

// Quita metadata de exportación para no inflar el HTML.
const svg = raw
  .replace(/<metadata>[\s\S]*?<\/metadata>/g, '')
  .replace(/\s*xmlns:c2pa="[^"]*"/g, '')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<span
  class:list={['icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg}
/>
